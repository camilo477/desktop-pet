#!/usr/bin/env bash
set -eu

launcher="$(readlink -f -- "${BASH_SOURCE[0]}")"
project_dir="$(dirname -- "$launcher")"

if [[ ! -x "$project_dir/.venv/bin/python" ]]; then
    printf '%s\n' 'Falta el entorno virtual. Ejecuta install.sh en la carpeta del proyecto.' >&2
    exit 1
fi

exec "$project_dir/.venv/bin/python" "$project_dir/main.py" "$@"
